# Desktop module environment variables — copy to .env and fill in real values.
# .env is gitignored. Never commit real keys.
#
# Nothing here is required to run the test suite. The desktop module needs
# CEREBRAS_API_KEY for the agent path and GEMINI_API_KEY for background
# thinking; the rest are optional and the feature that uses them is skipped
# when the key is absent.

# --- Speech-to-text ---
DEEPGRAM_API_KEY=

# --- LLM / cloud fallback (Vertex/Gemini/Groq via litellm) ---
GOOGLE_API_KEY=
GEMINI_API_KEY=
GEMINI_KEY_PAID=
GEMINI_KEY_LIST=          # comma-separated for key rotation
GROQ_API_KEY=
GROQ_API_KEY_LIST=        # comma-separated for key rotation
OPENAI_API_KEY=

# --- Web search (tools.py search_web) ---
EXA_API_KEY=

# --- TTS (only needed if tts.provider = "inworld") ---
INWORLD_API_KEY=

# --- Self-extend (Smithery CLI / MCP) ---
SMITHERY_API_KEY=
GITHUB_TOKEN=
