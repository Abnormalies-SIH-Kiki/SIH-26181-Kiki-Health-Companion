# Wearable gateway configuration — copy to gateway.env and fill in.
# scripts/run_gateway.sh sources this file if it exists. gateway.env is gitignored.
#
# Every setting is read with a KIKI_GATEWAY_ prefix (kiki_gateway/config.py).
# Only the ones below usually need changing; everything else has a default.

# --- where the gateway listens ---
KIKI_GATEWAY_HOST=0.0.0.0
KIKI_GATEWAY_PORT=8765

# --- device authentication ---
# The ESP32 sends this token on connect. It is also compiled into the firmware
# via `idf.py menuconfig`, so the two must match. Empty disables the check,
# which is fine on a trusted LAN and not fine over Tailscale.
KIKI_GATEWAY_TOKEN=

# --- inference backends on this machine ---
KIKI_GATEWAY_LLAMA_URL=http://127.0.0.1:8080/v1/chat/completions
KIKI_GATEWAY_WHISPER_URL=http://127.0.0.1:5555/inference
KIKI_GATEWAY_TTS_URL=http://127.0.0.1:8082/v1/audio/speech

# --- the Pi's health service (desktop module) ---
KIKI_GATEWAY_HEALTH_URL=http://kiki-1:8091
KIKI_GATEWAY_HEALTH_TOKEN=

# --- care plan shared with the desktop module ---
KIKI_GATEWAY_CARE_DIR=
KIKI_GATEWAY_CARE_PLAN_FILE=
KIKI_GATEWAY_CARE_PLACE=
KIKI_GATEWAY_CARE_LATITUDE=
KIKI_GATEWAY_CARE_LONGITUDE=

# --- audio link ---
# Opus keeps the downlink near 32 kbps. Turn it off on a LAN where 48 kHz PCM fits.
KIKI_GATEWAY_OPUS_ENABLED=1

# --- web panel ---
KIKI_GATEWAY_WEBUI_PORT=8090
